{
    "name": "kalna-lab/flysystem-microsoft-graph",
    "description": "Flysystem v3 adapter for Microsoft Graph API v2.5 - SharePoint and OneDrive integration for Laravel 11+",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "flysystem",
        "microsoft-graph",
        "sharepoint",
        "onedrive",
        "laravel",
        "filesystem",
        "storage",
        "graph-api"
    ],
    "authors": [
        {
            "name": "KalnaIT",
            "email": "contact@kalna.it"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "league/flysystem": "^3.0",
        "microsoft/microsoft-graph": "^2.5",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^11.0",
        "illuminate/cache": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^9.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "KalnaLab\\FlysystemMicrosoftGraph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KalnaLab\\FlysystemMicrosoftGraph\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KalnaLab\\FlysystemMicrosoftGraph\\MicrosoftGraphServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
